# Convex — start local anonymous Convex first; it writes NEXT_PUBLIC_CONVEX_URL
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Set on the Convex deployment (not only in .env.local):
#   pnpm dlx convex env set CLERK_FRONTEND_API_URL "$CLERK_FRONTEND_API_URL"
CLERK_FRONTEND_API_URL=

# Optional — missing keys skip these clients
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Required for /api/geocode. HMAC secret for the hp_geo cookie.
# Generate: openssl rand -base64 32
# Set the same value on Vercel (Preview and Production) and on Convex
# (production deployment and preview env defaults). Do not reuse CLERK_SECRET_KEY.
GEOCODE_PROXY_SECRET=

# Optional — Warsaw address search via /api/geocode (falls back to static list)
LOCATIONIQ_API_KEY=

# MCP (admin). Exact public URL of /mcp, no query and no trailing slash.
# Production: https://parent.labdm.dev/mcp
# Local: http://localhost:3000/mcp
# Register that same URL in Clerk Dashboard → Agents → MCP servers.
MCP_RESOURCE_URL=

# HMAC for the Convex role lookup. Generate: openssl rand -base64 32
# Set the same value here and on the Convex deployment:
#   pnpm exec convex env set MCP_ROLE_SECRET "<value>"
# Do not reuse CLERK_SECRET_KEY, GEOCODE_PROXY_SECRET, or a Convex deploy key.
# /mcp returns 503 and names this variable when it is missing.
MCP_ROLE_SECRET=
