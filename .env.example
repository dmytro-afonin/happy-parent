# Convex — start local anonymous Convex first; it writes NEXT_PUBLIC_CONVEX_URL
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Set on the Convex deployment (not only in .env.local):
#   pnpm dlx convex env set CLERK_FRONTEND_API_URL "$CLERK_FRONTEND_API_URL"
CLERK_FRONTEND_API_URL=

# Optional — missing keys skip these clients
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional — Warsaw address search via /api/geocode (falls back to static list)
LOCATIONIQ_API_KEY=
