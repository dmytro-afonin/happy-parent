# Convex — run `pnpm dlx convex dev` to create a deployment and fill these in
VITE_CONVEX_URL=

# Clerk — https://dashboard.clerk.com
# Local / docs (TanStack Start):
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Vercel Marketplace also syncs NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (+ CLERK_SECRET_KEY).
# The app aliases NEXT_PUBLIC_* → VITE_/CLERK_PUBLISHABLE_KEY, so you do not need a
# separate manual VITE_CLERK_PUBLISHABLE_KEY on Vercel when the integration is connected.

# Clerk Frontend API URL for Convex auth (set on the Convex deployment):
#   pnpm dlx convex env set CLERK_FRONTEND_API_URL "https://<slug>.clerk.accounts.dev"
# (Production instance uses your Clerk Frontend API URL from the dashboard.)
CLERK_FRONTEND_API_URL=

# OSRM walking routes (optional — defaults to the public demo server)
VITE_OSRM_BASE_URL=

# ImageKit — https://imagekit.io/dashboard
# Set in Convex: pnpm dlx convex env set IMAGEKIT_PUBLIC_KEY pk_...
# pnpm dlx convex env set IMAGEKIT_PRIVATE_KEY private_...
# pnpm dlx convex env set IMAGEKIT_URL_ENDPOINT https://ik.imagekit.io/your_id
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
