{
    "build": {
      "dockerfile": "Dockerfile",
      "context": "."
    }, 
    "install": "pnpm install --frozen-lockfile",
    "terminals": [
      {
        "name": "Convex",
        "command": "pnpm exec convex dev"
      },
      {
        "name": "App",
        "command": "pnpm dev",
        "ports": [
          3000
        ]
      }
    ]
  }